{% extends 'base.html.twig' %}

{% block title %}Connexion administration{% endblock %}

{% block body %}
    <main>
        <h1>Administration Météo Mézenc</h1>
        {% if error %}<p role="alert">Identifiants incorrects.</p>{% endif %}
        <form method="post" action="{{ path('app_login') }}">
            <label for="username">Identifiant</label>
            <input id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" autocomplete="current-password" required>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit">Se connecter</button>
        </form>
    </main>
{% endblock %}
