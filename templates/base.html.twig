<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#193d4d">
        <title>{% block title %}Portail Météo Mézenc{% endblock %}</title>
        <link rel="icon" href="{{ app.request.basePath }}/logo.jpg">
        <link rel="stylesheet" href="{{ app.request.basePath }}/styles/portal.css">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#main">Aller au contenu</a>
        <header class="header">
            <a class="brand" href="{{ path('app_portal') }}" aria-label="Portail Météo Mézenc — Accueil">
                <img src="{{ app.request.basePath }}/logo.jpg" alt="Météo Mézenc, votre info météo locale" width="175" height="118">
                <span>Portail Météo Mézenc<small>La météo de votre commune</small></span>
            </a>
            <nav aria-label="Navigation principale">
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin') }}">Administration</a>{% endif %}
                    <a class="logout" href="{{ logout_path('main') }}">Déconnexion</a>
                {% else %}
                    <span class="nav-label">Votre espace de consultation</span>
                {% endif %}
            </nav>
        </header>
        {% block body %}{% endblock %}
        <footer class="footer"><span>Météo Mézenc</span><span>Votre information météo locale · Massif du Mézenc</span></footer>
    </body>
</html>
